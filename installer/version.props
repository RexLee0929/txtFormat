<Project>

  <!-- 版本与作者信息的唯一来源（规范 §十三.8）。改版本只改这里一处：
       · 主程序运行时：app/core/version.py 解析本文件（props 随包进 exe，运行期与开发期同一份）；
       · exe 版本资源：txtFormat.spec 打包时从本文件现生成（tools/ 不存手写版本资源）；
       · 安装器：csproj Import 本文件，运行时从自身程序集读取版本号。 -->
  <PropertyGroup>
    <Version>1.0.5</Version>
    <Company>Rex Lee</Company>
    <Authors>Rex Lee</Authors>
    <Product>txtFormat</Product>
    <Copyright>Copyright © 2026 Rex Lee</Copyright>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
  </PropertyGroup>

</Project>
