<Project>

  <!-- 版本与作者信息的唯一来源。
       改版本只改这里一处：main.py 的 version.py 与 tools/version_info.txt 同步；
       安装器运行时从自身程序集读取版本号。 -->
  <PropertyGroup>
    <Version>1.0.4</Version>
    <Company>Rex Lee</Company>
    <Authors>Rex Lee</Authors>
    <Product>txtFormat</Product>
    <Copyright>Copyright © 2026 Rex Lee</Copyright>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
  </PropertyGroup>

</Project>